# Direct-model settings; only used when AGENT_RUNTIME=direct.
# Default manual mode never calls an external model.
MODEL_API_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=30
# deepseek enables bounded non-thinking JSON output; compatible preserves the generic adapter.
MODEL_PROVIDER=compatible
# Leave empty to generate a persistent local secret in data/.session-secret.
SESSION_SECRET=
DATA_DIR=./data
PORT=8765
VIPS_CONCURRENCY=2

# manual: image controls available, conversation disabled.
# openclaw: requires a verified target-version adapter and plugin handshake.
# direct: explicit model API connection for conversation; never an automatic fallback.
AGENT_RUNTIME=manual
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=lut-color
OPENCLAW_BRIDGE_TOKEN=
# Do not set verified=true before the actual target version and native adapter pass O0/O3.
OPENCLAW_VERIFIED_VERSION=
OPENCLAW_COMPATIBILITY_VERIFIED=false
AGENT_TIMEOUT=90
AGENT_TOOL_LIMIT=12

# Independent text embeddings. Leave disabled until an endpoint is configured.
# compatible also supports explicitly configured local HTTP embedding servers.
EMBEDDING_PROVIDER=disabled
# Example for Bailian Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_VERSION=1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# false for fixed-dimension models such as SiliconFlow BAAI/bge-m3; response validation remains enabled.
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=10
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Set only after evaluating the chosen model; blank means semantic-only hits need review.
EMBEDDING_MIN_SIMILARITY=
